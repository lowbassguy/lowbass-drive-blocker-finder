<!--
    Title:   lowbass' Drive Blocker Finder - App XAML
    Author:  Joshua "lowbass" Sommerfeldt
    Date:    2026-05-14
    Purpose: WPF application entry point. Points at MainWindow as the startup view.
             Merges WPF-UI's Fluent Design theme dictionaries (Dark by default) so
             every Wpf.Ui control inherits the Win11 native look + dark palette.
-->
<Application x:Class="LowbassDriveBlockerFinder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The order matters: themes first, then controls. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
