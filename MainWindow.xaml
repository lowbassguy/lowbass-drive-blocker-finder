<!--
    Title:   lowbass' Drive Blocker Finder - Main Window XAML
    Author:  Joshua "lowbass" Sommerfeldt
    Date:    2026-05-14
    Purpose: Single-window UI. Layout (top to bottom):
               * Action bar - drive picker, Refresh / Scan / Eject, toggles
               * Blockers grid - PID, name, reason, main module, Kill button
               * Log panel - live tail of structured log lines
-->
<Window x:Class="LowbassDriveBlockerFinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="lowbass' Drive Blocker Finder"
        Height="720" Width="1080"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Action bar -->
            <RowDefinition Height="Auto" />  <!-- Status line -->
            <RowDefinition Height="*"    />  <!-- Blockers grid -->
            <RowDefinition Height="220"  />  <!-- Log panel -->
        </Grid.RowDefinitions>

        <!-- =================== Action bar =================== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Drive:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="DriveCombo" Width="420" />
            <Button x:Name="RefreshButton" Content="🔄 Refresh"
                    Margin="8,0,0,0" Padding="10,5"
                    Click="RefreshButton_Click"
                    ToolTip="Re-enumerate drives" />
            <Button x:Name="ScanButton" Content="🔍 Scan blockers"
                    Margin="8,0,0,0" Padding="10,5"
                    Click="ScanButton_Click"
                    ToolTip="Find processes that appear to be using the selected drive" />
            <Button x:Name="EjectButton" Content="⏏ Eject"
                    Margin="8,0,0,0" Padding="10,5"
                    Click="EjectButton_Click"
                    ToolTip="Lock, dismount, and eject the selected drive" />
            <Separator Margin="12,4" />
            <CheckBox x:Name="VerboseCheck" Content="Verbose"
                      IsChecked="True" VerticalAlignment="Center" Margin="6,0,0,0"
                      Checked="Verbose_Toggle" Unchecked="Verbose_Toggle"
                      ToolTip="Include DEBUG lines in the log" />
            <CheckBox x:Name="EmojiCheck" Content="Emojis"
                      IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0"
                      Checked="Emoji_Toggle" Unchecked="Emoji_Toggle"
                      ToolTip="Prefix log lines with an emoji per level" />
        </StackPanel>

        <!-- =================== Status line =================== -->
        <TextBlock Grid.Row="1" x:Name="StatusText"
                   Text="Ready. Pick a drive and hit Scan."
                   Margin="0,0,0,8" Foreground="#555" FontStyle="Italic" />

        <!-- =================== Blockers grid =================== -->
        <DataGrid Grid.Row="2" x:Name="ProcessGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  AlternatingRowBackground="#F7F7FA" RowHeight="26"
                  CanUserResizeRows="False"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID"          Binding="{Binding Pid}"          Width="64"  />
                <DataGridTextColumn Header="Process"      Binding="{Binding ProcessName}"  Width="180" />
                <DataGridTextColumn Header="Reason"       Binding="{Binding Reason}"       Width="240" />
                <DataGridTextColumn Header="Main module"  Binding="{Binding MainModule}"   Width="*"   />
                <DataGridTemplateColumn Header="Action" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="❌ Kill" Padding="6,2"
                                    Click="KillProcess_Click"
                                    Tag="{Binding Pid}"
                                    ToolTip="Force-terminate this process (releases everything it's holding)" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <!-- Row details: shown when the row is selected. Lists each file this
                 process is holding on the drive, with per-file Show + Close buttons.
                 Show: smart-find the right window (matches title to filename/folder).
                 Close: force-close JUST that handle in the source process. -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="#F0F4FA" BorderBrush="#C8D2E0" BorderThickness="1"
                            Padding="10,8" Margin="20,4,4,8">
                        <StackPanel>
                            <TextBlock Text="Open files on the drive (click row to collapse):"
                                       FontWeight="Bold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding BlockingFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Path}"
                                                       FontFamily="Consolas" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}" />
                                            <Button Grid.Column="1" Content="👁 Show" Padding="6,2"
                                                    Margin="8,0,4,0"
                                                    Click="ShowFileWindow_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Find the window holding this file and bring it forward" />
                                            <Button Grid.Column="2" Content="🔓 Close" Padding="6,2"
                                                    Click="CloseFileHandle_Click"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding CanCloseHandle}"
                                                    ToolTip="Force-close just this file handle in the owner process (advanced - may crash the source process)" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <!-- =================== Log panel =================== -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*"    />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock Text="📋 Log" FontWeight="Bold" />
                <Button DockPanel.Dock="Right" Content="Open log file"
                        Padding="6,2" Click="OpenLogFile_Click"
                        HorizontalAlignment="Right" />
                <Button DockPanel.Dock="Right" Content="Clear" Margin="0,0,8,0"
                        Padding="6,2" Click="ClearLog_Click"
                        HorizontalAlignment="Right" />
            </DockPanel>
            <TextBox Grid.Row="1" x:Name="LogBox"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11"
                     TextWrapping="NoWrap" Background="#111" Foreground="#DDD"
                     Margin="0,4,0,0" />
        </Grid>
    </Grid>
</Window>
